{
  "name": "site2api",
  "version": "0.0.1",
  "description": "Turn any website you use into a verified MCP server — in one command.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "site2api": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node20 --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx demo/shop/server.ts",
    "record-fixture": "tsx scripts/record-fixture.ts"
  },
  "keywords": [
    "mcp",
    "openapi",
    "har",
    "reverse-engineering",
    "agent",
    "claude-code"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "express": "^5.3.0",
    "playwright": "^1.64.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
